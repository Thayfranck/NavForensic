{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NavForensics",
  "version": "2.4.2",
  "identifier": "fr.ofac.navforensics",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "NavForensics - lecture forensique des navigateurs",
        "width": 1320,
        "height": 800,
        "minWidth": 940,
        "minHeight": 580
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
